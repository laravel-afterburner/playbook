{
    "name": "laravel-afterburner/playbook",
    "description": "In-app playbook documentation for Afterburner applications",
    "version": "1.3.1",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel-afterburner/jetstream": "^1.0|dev-master",
        "livewire/livewire": "^3.5",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Afterburner\\Playbook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Afterburner\\Playbook\\Tests\\": "tests/",
            "App\\Models\\": "tests/Fixtures/Models/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "pint": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Afterburner\\Playbook\\Providers\\PlaybookServiceProvider"
            ],
            "commands": [
                "Afterburner\\Playbook\\Console\\Commands\\InstallCommand",
                "Afterburner\\Playbook\\Console\\Commands\\ValidatePlaybookCommand"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
